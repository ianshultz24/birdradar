# eBird API (required) — https://ebird.org/api/keygen
EBIRD_API_KEY=

# Stadia Maps basemap tiles — required for ANY non-localhost origin.
# https://client.stadiamaps.com → Manage Properties → API Keys, and add your
# domain under "Authentication Configuration" while you're there.
#
# Keyless requests are served only from localhost / 127.0.0.1 / private LAN
# addresses. Every other origin gets HTTP 401 and a watermark tile that still
# renders as a valid image, so the map looks loaded but is wrong.
#
# NEXT_PUBLIC_ means this ships in the client bundle — that is intended; the
# domain allowlist is the protection, not secrecy. It is also inlined at BUILD
# time, so setting it on the host requires a fresh deploy, not a restart.
NEXT_PUBLIC_STADIA_API_KEY=

# OpenRouteService — drive-time badges. https://openrouteservice.org/dev/#/signup
#
# SERVER-ONLY. Never NEXT_PUBLIC_: that would ship the key in the client bundle.
# next.config.ts sets `connect-src 'self'`, so a browser-side call to
# api.openrouteservice.org is blocked by CSP anyway — the proxy at
# /api/drive-time is structural, not stylistic.
#
# Must ALSO be set in Vercel → Settings → Environment Variables for BOTH
# Production and Preview. Unlike NEXT_PUBLIC_STADIA_API_KEY this is read at
# request time, so changing it on the host takes effect on restart — no rebuild.
#
# Passed to ORS as a bare `Authorization` header with NO "Bearer " prefix.
# A prefixed key is rejected as "api_key missing", i.e. it looks like no key
# at all. See app/api/drive-time/route.ts.
ORS_API_KEY=
# Optional: cap ORS calls per rolling 24h (default 450). Sized under the LOWEST
# quota ORS publishes — its own pages give 500/2000/2500 for different endpoints
# and plans, and the widely quoted 2000/day is the *directions* endpoint, not
# matrix. A breaker set above the real ceiling never fires. Raise only once the
# ORS dashboard shows what this key actually gets.
ORS_DAILY_BUDGET=450

# Coarse location fallback — DEVELOPMENT CONVENIENCE ONLY, leave empty in prod.
#
# Used by /api/geo-estimate, which is reached only when the user turns
# "Precise location" OFF in Settings. In production the estimate comes from
# Vercel's own `x-vercel-ip-latitude` / `-longitude` request headers: free, no
# key, available on every plan including Hobby, and no extra round trip.
#
# Those headers do not exist on localhost, so without this the OFF path can only
# ever be observed returning `{"coords":null}` locally. Point it at any endpoint
# whose JSON carries latitude/longitude (e.g. https://ipapi.co/json/) to exercise
# the success branch in dev.
#
# Server-only on purpose: next.config.ts pins `connect-src 'self'`, so the
# browser cannot call an IP-geo service directly even if this were public.
IP_GEO_URL=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis (recommended in prod) — shared rate limiting, upstream budget,
# response cache, and push-alert dedupe. https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: cap deployment-wide eBird calls/min (default 100)
EBIRD_UPSTREAM_BUDGET_PER_MIN=100

# Push alerts (Phase 3) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@birdradar.app

# Neon Postgres (Phase 3) — stores alert subscriptions. https://neon.tech
DATABASE_URL=

# Shared secret the alert-watcher cron sends as `Authorization: Bearer <secret>`
CRON_SECRET=
