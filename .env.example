# eBird API (required) — https://ebird.org/api/keygen
EBIRD_API_KEY=

# Stadia Maps basemap tiles — required for ANY non-localhost origin.
# https://client.stadiamaps.com → Manage Properties → API Keys, and add your
# domain under "Authentication Configuration" while you're there.
#
# Keyless requests are served only from localhost / 127.0.0.1 / private LAN
# addresses. Every other origin gets HTTP 401 and a watermark tile that still
# renders as a valid image, so the map looks loaded but is wrong.
#
# NEXT_PUBLIC_ means this ships in the client bundle — that is intended; the
# domain allowlist is the protection, not secrecy. It is also inlined at BUILD
# time, so setting it on the host requires a fresh deploy, not a restart.
NEXT_PUBLIC_STADIA_API_KEY=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis (recommended in prod) — shared rate limiting, upstream budget,
# response cache, and push-alert dedupe. https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: cap deployment-wide eBird calls/min (default 100)
EBIRD_UPSTREAM_BUDGET_PER_MIN=100

# Push alerts (Phase 3) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@birdradar.app

# Neon Postgres (Phase 3) — stores alert subscriptions. https://neon.tech
DATABASE_URL=

# Shared secret the alert-watcher cron sends as `Authorization: Bearer <secret>`
CRON_SECRET=
